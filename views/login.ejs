<!doctype html>
<html lang="en">
  <head>
    <script>
      (() => {
        try {
          const stored = localStorage.getItem("themeMode");
          if (
            stored
              ? stored === "dark"
              : matchMedia("(prefers-color-scheme: dark)").matches
          ) {
            document.documentElement.classList.add("dark");
          }
        } catch (_) {}

        const apply = (dark) => {
          document.documentElement.classList.toggle("dark", dark);
          try {
            localStorage.setItem("themeMode", dark ? "dark" : "light");
          } catch (_) {}
        };

        document.addEventListener("basecoat:theme", (event) => {
          const mode = event.detail?.mode;
          apply(
            mode === "dark"
              ? true
              : mode === "light"
                ? false
                : !document.documentElement.classList.contains("dark"),
          );
        });
      })();
    </script>

    <script>
      (function () {
        try {
          const storedTheme = localStorage.getItem("themeVariant");
          if (storedTheme)
            document.documentElement.classList.add(`theme-${storedTheme}`);
        } catch (event) {
          console.error("Could not apply theme variant from localStorage", event);
        }
      })();
    </script>

    <meta charset="utf-8" />
    <meta http-equiv="Content-Language" content="en" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login</title>

    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
    <link rel="stylesheet" href="/assets/styles.css" />

    <script src="/assets/js/basecoat.js?v=0.3.11" defer></script>
    <script src="/assets/js/command.js?v=0.3.11" defer></script>
    <script src="/assets/js/dropdown-menu.js?v=0.3.11" defer></script>
    <script src="/assets/js/popover.js?v=0.3.11" defer></script>
    <script src="/assets/js/select.js?v=0.3.11" defer></script>
    <script src="/assets/js/sidebar.js?v=0.3.11" defer></script>
    <script src="/assets/js/tabs.js?v=0.3.11" defer></script>
    <script src="/assets/js/toast.js?v=0.3.11" defer></script>
  </head>
  <body class="bg-background">
    <div class="flex min-h-svh flex-col items-center justify-center bg-muted p-6 md:p-10">
      <div class="w-full max-w-sm md:max-w-4xl">
        <div class="flex flex-col gap-6">
          <div
            data-slot="card"
            class="flex flex-col gap-6 rounded-xl border bg-card text-card-foreground shadow-sm overflow-hidden p-0"
          >
            <div data-slot="card-content" class="grid p-0 md:grid-cols-2">
              <form class="p-6 md:p-8" action="/login" method="POST">
                <div
                  data-slot="field-group"
                  class="group/field-group @container/field-group flex w-full flex-col gap-7"
                >
                  <div class="flex flex-col items-center gap-2 text-center">
                    <h1 class="text-2xl font-bold">Welcome back</h1>
                    <p class="text-balance text-muted-foreground">Login to your account</p>
                  </div>

                  <% if (error) { %>
                    <div class="bg-destructive/15 text-destructive text-sm p-3 rounded-md border border-destructive/20 text-center">
                      <%= error %>
                    </div>
                  <% } %>

                  <!-- Email Field -->
                  <div
                    role="group"
                    data-slot="field"
                    data-orientation="vertical"
                    class="group/field flex w-full gap-3 flex-col"
                  >
                    <label
                      data-slot="field-label"
                      class="text-sm font-medium select-none"
                      for="email"
                    >Email</label>
                    <input
                      type="email"
                      name="email"
                      data-slot="input"
                      class="h-9 w-full min-w-0 rounded-md border border-input bg-transparent px-3 py-1 text-base shadow-xs transition-[color,box-shadow] outline-none placeholder:text-muted-foreground disabled:opacity-50 md:text-sm dark:bg-input/30 focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50"
                      id="email"
                      placeholder="admin@admin.com"
                      required
                    />
                  </div>

                  <!-- Password Field -->
                  <div
                    role="group"
                    data-slot="field"
                    data-orientation="vertical"
                    class="group/field flex w-full gap-3 flex-col"
                  >
                    <div class="flex items-center">
                      <label
                        data-slot="field-label"
                        class="text-sm font-medium select-none"
                        for="password"
                      >Password</label>
                      <a href="#" class="ml-auto text-sm underline-offset-2 hover:underline">Forgot your password?</a>
                    </div>
                    <input
                      type="password"
                      name="password"
                      data-slot="input"
                      class="h-9 w-full min-w-0 rounded-md border border-input bg-transparent px-3 py-1 text-base shadow-xs transition-[color,box-shadow] outline-none placeholder:text-muted-foreground disabled:opacity-50 md:text-sm dark:bg-input/30 focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50"
                      id="password"
                      required
                    />
                  </div>

                  <!-- Submit Button -->
                  <div role="group" data-slot="field" class="flex w-full flex-col">
                    <button
                      data-slot="button"
                      data-variant="default"
                      class="inline-flex items-center justify-center gap-2 rounded-md text-sm font-medium whitespace-nowrap transition-all outline-none bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-4 py-2"
                      type="submit"
                    >
                      Login
                    </button>
                  </div>

                  <p class="text-sm text-muted-foreground text-center">
                    Don't have an account? <a href="#" class="underline underline-offset-4 hover:text-primary">Sign up</a>
                  </p>
                </div>
              </form>
              <div class="relative hidden bg-muted md:block">
                <img
                  src="/assets/images/placeholder.svg"
                  alt="Image"
                  class="absolute inset-0 h-full w-full object-cover dark:brightness-[0.2] dark:grayscale"
                />
              </div>
            </div>
          </div>
          <p class="text-sm text-muted-foreground text-center px-6">
            By clicking continue, you agree to our
            <a href="#" class="underline underline-offset-4 hover:text-primary">Terms of Service</a>
            and
            <a href="#" class="underline underline-offset-4 hover:text-primary">Privacy Policy</a>.
          </p>
        </div>
      </div>
    </div>
  </body>
</html>