              <div class="flow-item">
                <span class="flow-number bg-primary text-primary-foreground">6</span>
                <span>
                  Klik <strong>Export Attendance Excel</strong> untuk mengunduh
                  file rekap attendance dalam format Excel.
                </span>
              </div>

              <div class="flow-item">
                <span class="flow-number bg-primary text-primary-foreground">7</span>
                <span>
                  Klik menu <strong>API</strong> untuk memastikan REST API
                  menampilkan data dalam format JSON.
                </span>
              </div>
            </section>
          </section>
        </div>
      </div>
    </main>

    <div id="toaster" class="toaster"></div>
  </body>
</html>