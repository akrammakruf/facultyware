      <div class="p-4 md:p-6 xl:p-12">
        <div class="dashboard-wrapper">
          <header class="dashboard-header">
            <h1 class="dashboard-title">
              Dashboard Reminder, Check-in & Attendance
            </h1>

            <p class="dashboard-subtitle text-muted-foreground">
              Selamat datang,
              <strong class="text-foreground">
                <%= typeof user !== "undefined" && user ? user : "Admins" %>
              </strong>.
              Halaman ini berfokus pada fitur dalam FTI Event Management:
              pengiriman reminder event, validasi check-in peserta, pencatatan
              attendance, rekap kehadiran, export Excel, dan REST API.
            </p>
          </header>

          <section class="dashboard-grid">
            <div class="card dashboard-card">
              <header>
                <h2>Kirim Reminder</h2>
                <p class="text-muted-foreground">
                  Kirim reminder kepada peserta yang sudah terdaftar pada event
                  yang berstatus published.
                </p>
              </header>

              <footer class="card-footer-actions">
                <a href="/reminders" class="btn">Buka Reminder</a>
              </footer>
            </div>

            <div class="card dashboard-card">
              <header>
                <h2>Riwayat Reminder</h2>
                <p class="text-muted-foreground">
                  Lihat daftar reminder yang sudah dikirim, termasuk event,
                  channel, pesan, pengirim, dan waktu pengiriman.
                </p>
              </header>

              <footer class="card-footer-actions">
                <a href="/reminders/history" class="btn">Lihat Riwayat</a>
              </footer>
            </div>

            <div class="card dashboard-card">
