<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Edit Event - Facultyware</title>

    <link rel="stylesheet" href="/assets/styles.css" />

    <script src="https://unpkg.com/htmx.org@2.0.4"></script>

    <script>
      (() => {
        try {
          if (
            localStorage.getItem("themeMode") === "dark" ||
            (!localStorage.getItem("themeMode") &&
              matchMedia("(prefers-color-scheme: dark)").matches)
          ) {
            document.documentElement.classList.add("dark");
          }
        } catch (_) {}
      })();
    </script>

    <script>
      (function () {
        try {
          const storedTheme = localStorage.getItem("themeVariant");
          if (storedTheme) {
            document.documentElement.classList.add(`theme-${storedTheme}`);
          }
        } catch (event) {
          console.error("Could not apply theme variant", event);
        }
      })();
    </script>
  </head>

  <body class="bg-background text-foreground antialiased p-6 md:p-10">
    <div class="max-w-3xl mx-auto space-y-6">
      <header class="flex justify-between items-center pb-6 border-b border-border">
        <div class="flex items-center gap-2">
          <span class="font-bold text-xl tracking-tight">Facultyware</span>
          <span class="text-xs text-muted-foreground bg-muted px-2 py-0.5 rounded">Admin Event</span>
        </div>

        <nav class="flex gap-4 items-center">
          <a href="/home" class="text-sm font-medium hover:underline">Dashboard</a>
          <a href="/admin/events" class="text-sm font-medium hover:underline">Manajemen Event</a>
          <a href="/logout" class="text-sm font-medium hover:underline">Logout</a>
        </nav>
      </header>

      <main class="space-y-6">
        <div>
          <h1 class="text-3xl font-bold tracking-tight">Edit Event</h1>
          <p class="text-muted-foreground text-sm mt-2">
            Perbarui informasi event. Perubahan akan langsung tersimpan setelah disubmit.
          </p>
        </div>

        <div data-slot="card" class="rounded-xl border border-border bg-card text-card-foreground shadow-md">
          <form action="/admin/events/<%= event.id %>/edit" method="POST" class="p-6 space-y-4">
            <div>
              <label class="text-sm font-medium block mb-1.5" for="title">Nama Event</label>
              <input
                type="text"
                id="title"
                name="title"
                value="<%= event.title || '' %>"
                required
                class="w-full h-10 rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-xs transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
              />
            </div>

            <div>
              <label class="text-sm font-medium block mb-1.5" for="description">Deskripsi</label>
              <textarea
                id="description"
                name="description"
                rows="4"
                class="w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-xs transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
              ><%= event.description || '' %></textarea>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="text-sm font-medium block mb-1.5" for="event_type">Jenis Event</label>
                <select
                  id="event_type"
                  name="event_type"
                  class="w-full h-10 rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-xs"
                >
                  <% ['seminar','workshop','training','conference','webinar','other'].forEach((type) => { %>
                    <option value="<%= type %>" <%= event.event_type === type ? 'selected' : '' %>>
                      <%= type %>
                    </option>
                  <% }) %>
                </select>
              </div>

              <div>
                <label class="text-sm font-medium block mb-1.5" for="delivery_mode">Mode Pelaksanaan</label>
                <select
                  id="delivery_mode"
                  name="delivery_mode"
                  class="w-full h-10 rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-xs"
                >
                  <% ['offline','online','hybrid'].forEach((mode) => { %>
                    <option value="<%= mode %>" <%= event.delivery_mode === mode ? 'selected' : '' %>>
                      <%= mode %>
                    </option>
                  <% }) %>
                </select>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="text-sm font-medium block mb-1.5" for="start_date">Tanggal Mulai</label>
                <input
                  type="date"
                  id="start_date"
                  name="start_date"
                  value="<%= event.start_date ? new Date(event.start_date).toISOString().slice(0,10) : '' %>"
                  class="w-full h-10 rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-xs"
                />
              </div>

              <div>
                <label class="text-sm font-medium block mb-1.5" for="end_date">Tanggal Selesai</label>
                <input
                  type="date"
                  id="end_date"
                  name="end_date"
                  value="<%= event.end_date ? new Date(event.end_date).toISOString().slice(0,10) : '' %>"
                  class="w-full h-10 rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-xs"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="text-sm font-medium block mb-1.5" for="venue">Lokasi / Venue</label>
                <input
                  type="text"
                  id="venue"
                  name="venue"
                  value="<%= event.venue || '' %>"
                  class="w-full h-10 rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-xs"
                />
              </div>

              <div>
                <label class="text-sm font-medium block mb-1.5" for="quota">Kuota Peserta</label>
                <input
                  type="number"
                  id="quota"
                  name="quota"
                  min="0"
                  value="<%= event.quota || '' %>"
                  class="w-full h-10 rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-xs"
                />
              </div>
            </div>

            <div class="flex gap-3 pt-2">
              <button
                type="submit"
                class="inline-flex items-center justify-center rounded-md text-sm font-medium bg-primary text-primary-foreground h-10 px-4 py-2 hover:bg-primary/90 transition-colors"
              >
                Simpan Perubahan
              </button>

              <a
                href="/admin/events"
                class="inline-flex items-center justify-center rounded-md text-sm font-medium border border-border bg-background h-10 px-4 py-2 hover:bg-accent transition-colors"
              >
                Batal
              </a>
            </div>
          </form>
        </div>
      </main>
    </div>
  </body>
</html>
