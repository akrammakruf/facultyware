<h1>Tambah Event</h1>

<form action="/admin/events/add" method="POST">

    <input
        type="text"
        name="title"
        placeholder="Judul Event"
        required>

    <br><br>

    <textarea
        name="description"
        placeholder="Deskripsi"></textarea>

    <br><br>

    <input
        type="text"
        name="venue"
        placeholder="Lokasi">

    <br><br>

    <input
        type="date"
        name="start_date">

    <br><br>

    <input
        type="date"
        name="end_date">

    <br><br>

    <button type="submit">
        Simpan
    </button>

</form>